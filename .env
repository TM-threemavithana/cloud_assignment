# Windows absolute project path (using WSL path style)
PROJECT_ROOT=/mnt/c/Users/User/cloud_assignment

# Java/Hadoop locations (update if your WSL paths differ)
JAVA11_HOME=/usr/lib/jvm/java-11-openjdk-amd64
HADOOP_HOME=/usr/local/hadoop

# Input and outputs
INPUT_CSV=${PROJECT_ROOT}/data/top_100_cryptos_with_correct_network.csv
JAR_PATH=${PROJECT_ROOT}/crypto-analysis.jar
LOCAL_OUTPUT_DIR=${PROJECT_ROOT}/hadoop_output
LOCAL_TOPK_OUTPUT_DIR=${PROJECT_ROOT}/hadoop_output_topk

# HDFS locations
HDFS_INPUT_DIR=/crypto_input
HDFS_OUTPUT_DIR=/crypto_output
HDFS_TOPK_OUTPUT_DIR=/crypto_topk_output

# Top-K setting for second job
TOPK_K=10